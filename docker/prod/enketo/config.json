{
  "app name": "Koda Enketo Production",
  "base path": "-",
  "query parameter to pass to submission": "st",
  "csrf cookie name": "__csrf",
  "default theme": "kobo",
  "encryption key": "${ENKETO_ENCRYPTION_KEY}",
  "expiry for record cache": 3600000,
  "frameguard deny": true,
  "ip filtering": {
    "allowIPAddressList": [],
    "allowMetaIPAddress": false,
    "allowPrivateIPAddress": false,
    "denyAddressList": []
  },
  "less secure encryption key": "${ENKETO_LESS_SECURE_ENCRYPTION_KEY}",
  "linked form and data server": {
    "api key": "${ENKETO_API_KEY}",
    "authentication": {
      "type": "basic",
      "allow insecure transport": false
    },
    "name": "ODK Central Production",
    "server url": "${ODK_CENTRAL_PRODUCTION_URL}",
    "legacy formhub": false
  },
  "log": {
    "submissions": true
  },
  "max processes": 16,
  "no sniff": true,
  "offline enabled": true,
  "port": "8005",
  "redis": {
    "cache": {
      "db": 1,
      "host": "redis",
      "password": null,
      "port": "6379"
    },
    "main": {
      "db": 0,
      "host": "redis",
      "password": null,
      "port": "6379"
    }
  },
  "support": {
    "email": "support@kodaap.com"
  },
  "widgets": [
    "note",
    "select-desktop",
    "select-mobile",
    "autocomplete",
    "geo",
    "textarea",
    "url",
    "table",
    "radio",
    "date",
    "time",
    "datetime",
    "select-media",
    "file",
    "draw",
    "rank",
    "likert",
    "range",
    "columns",
    "image-view",
    "comment",
    "image-map",
    "date-native",
    "date-native-ios",
    "date-mobile",
    "text-max",
    "text-print",
    "rating",
    "thousands-sep",
    "integer",
    "decimal"
  ],
  "timeout": 30000
}