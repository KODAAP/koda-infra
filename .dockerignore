# ==========================================
# Dockerignore - Koda
# ==========================================

# === Docker Configuration ===
.dockerignore
*.tar
docker-compose*.override.yml
docker-compose.local.yml 

# === Git ===
.git
**/.git
.gitignore

# === Python ===
*.pyc
*.pyo
__pycache__
**/__pycache__
venv
.venv
*.egg-info
**/*.egg-info
.pytest_cache
**/.pytest_cache
.coverage
htmlcov

# === Node.js / Next.js ===
client/node_modules/
**/node_modules/
client/.next/
client/.turbo/
client/out/
client/.env*.local
client/coverage/

# === IDE ===
.idea
**/.idea
.vscode
**/.vscode
*.swp
*.swo

# === Logs ===
*.log
logs/
**/logs/

# === Django ===
staticfiles/
backend/media/

# === Environnement ===
.envs/*
backend/.envs/*
.env
.env.*
!.env.example
!client/.env.prod

# === OS ===
.DS_Store
Thumbs.db

# === Documentation (optionnel) ===
docs/
*.md
!README.md
site/

# === Tooling & Agents ===
.agents/
.gemini/